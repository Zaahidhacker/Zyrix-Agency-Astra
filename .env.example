# Local development: SQLite is created automatically. No credentials needed for the public site.
SITE_URL=http://localhost:3000
SQLITE_PATH=.data/astra.sqlite

# Admin workspace: generate both with npm run admin:hash. Never commit real values.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Recommended production persistence (Supabase direct/pooler Postgres URL works).
DATABASE_URL=
# Use require when the PostgreSQL provider requires TLS.
DATABASE_SSL=require

# Self-hosted production SQLite is opt-in and REQUIRES a persistent mounted volume.
# Never enable SQLite on an ephemeral/serverless filesystem.
ALLOW_SQLITE=false

# Set ONLY to an IP header that your trusted reverse proxy overwrites.
# Vercel: x-vercel-forwarded-for. Other providers: follow their documented proxy contract.
# If unset, a conservative shared rate limit protects the endpoints.
TRUSTED_IP_HEADER=
NEXT_TELEMETRY_DISABLED=1
